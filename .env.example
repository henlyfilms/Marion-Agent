# Copy to .env. Keep provider keys out of Git.
HOST=127.0.0.1
PORT=8787
APP_URL=http://127.0.0.1:8787
SERVER_URL=http://127.0.0.1:8787
DEV_LOGIN=1

# Local primary model for agent chat and memory. Match the ID served by your runtime.
MARION_LOCAL_MODEL=qwen3.8:27b
MARION_LOCAL_MODEL_URL=http://127.0.0.1:11434/v1
# MARION_LOCAL_MODEL_API_KEY=

# Optional hosted Grok connector and xAI voice.
XAI_API_KEY=
XAI_MODEL=grok-4.6

# Required for Google sign-in and connected apps.
COMPOSIO_API_KEY=

# Optional desktop image override. Build the default from desktop/Dockerfile.
# MARION_DESKTOP_IMAGE=marion-agent-desktop:local

# Optional local speech-to-text. Use a local server that accepts OpenAI-style
# multipart audio and returns {"text":"..."}.
# MARION_STT_URL=http://127.0.0.1:8001/v1/audio/transcriptions
# MARION_STT_MODEL=whisper-1
# MARION_STT_API_KEY=
